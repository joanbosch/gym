{
  "name": "gym",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:dev": "email dev --dir emails --port 3001",
    "supabase:push": "supabase db push --db-url \"$SUPABASE_DB_URL\" --include-all",
    "supabase:seed": "supabase db push --db-url \"$SUPABASE_DB_URL\" --include-seed",
    "supabase:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > src/types/database.generated.ts",
    "auth:generate": "better-auth generate --config scripts/auth-cli-config.ts --output supabase/migrations/202608060000_better_auth.sql --yes",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@hookform/resolvers": "^5.7.1",
    "@supabase/supabase-js": "^2.112.1",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.84.0",
    "recharts": "3.8.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "pg-mem": "^3.0.14",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.5.0"
}
